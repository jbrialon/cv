---
import SectionRow from './SectionRow.astro';
import ButtonLink from './ButtonLink.astro';
import { profile } from '../data/profile';
---

<SectionRow title="Profile" id="profile" icon="sphere">
  <div class="profile-column">
    <h3 class="heading-3">{profile.headline}</h3>
    {profile.summary.map((paragraph) => <p class="paragraph">{paragraph}</p>)}
  </div>

  <div class="profile-column">
    <h3 class="heading-3">Contact</h3>
    <p class="paragraph location">{profile.location}</p>
    <ul class="contact-links">
      {profile.contactLinks.map((contactLink) => (
        <li>
          <ButtonLink href={contactLink.href} external={contactLink.external}>
            {contactLink.label}
          </ButtonLink>
        </li>
      ))}
    </ul>
  </div>
</SectionRow>

<style>
  .profile-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .location {
    color: var(--color-ink-soft);
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media print {
    .profile-column {
      grid-column: 1 / -1;
      gap: 16px;
    }

    .profile-column + .profile-column {
      display: none;
    }
  }
</style>
