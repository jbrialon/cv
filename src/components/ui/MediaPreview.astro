---
import type { CollectionEntry } from "astro:content";

interface Props {
  media: NonNullable<CollectionEntry<"projects">["data"]["media"]>;
}

const { media } = Astro.props;
---

<div class="media-preview" style={`--media-position: ${media.position}`}>
  {media.type === "video" && (
    <>
      <img class="media-preview-poster" src={media.poster} alt="" loading="lazy" decoding="async" width="1920" height="1080" />
      <video class="media-preview-video" data-src={media.src} muted loop playsinline preload="none" aria-hidden="true"></video>
    </>
  )}
  {media.type === "image" && (
    <picture>
      <source srcset={`${media.src}.webp`} type="image/webp" />
      <img src={`${media.src}.jpg`} alt={media.alt} loading="lazy" decoding="async" width="1200" height="739" />
    </picture>
  )}
</div>

<script>
  // the video file only loads on the first hover + touch screens and reduced motion keep the poster
  const canHover = window.matchMedia("(hover: hover)");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLVideoElement>(".media-preview-video").forEach((videoElement) => {
    const hoverTarget = videoElement.closest<HTMLElement>("[data-media-hover]") ?? videoElement.parentElement;
    if (!hoverTarget) return;

    hoverTarget.addEventListener("pointerenter", () => {
      if (!canHover.matches || prefersReducedMotion.matches) return;
      if (!videoElement.hasAttribute("src") && videoElement.dataset.src) videoElement.src = videoElement.dataset.src;
      videoElement.play().catch(() => {});
    });
    hoverTarget.addEventListener("pointerleave", () => videoElement.pause());
    videoElement.addEventListener("playing", () => videoElement.classList.add("is-playing"), { once: true });
  });
</script>

<style>
  .media-preview {
    position: absolute;
    inset: 0;

    img,
    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--media-position);
    }
  }

  .media-preview-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s linear;

    &.is-playing {
      opacity: 1;
    }
  }
</style>
