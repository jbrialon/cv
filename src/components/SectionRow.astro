---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
const headingId = `${id}-title`;
---

<section class="section-row" id={id} aria-labelledby={headingId}>
  <h2 class="heading-2 section-title" id={headingId}>
    <svg aria-hidden="true" width="12" height="12" viewBox="0 0 4 4" shape-rendering="crispEdges">
      <rect width="2" height="2" fill="currentColor"></rect>
      <rect x="2" y="2" width="2" height="2" fill="currentColor"></rect>
    </svg>
    {title}
  </h2>
  <slot />
</section>

<style>
  .section-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: 64px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .section-title {
    display: flex;
    gap: 12px;
    align-items: baseline;

    svg {
      color: var(--color-accent);
      flex-shrink: 0;
      transition: transform 0.4s var(--ease-out-quart);
    }
  }

  .section-row:has(:global(.button-link:hover, .button-link:focus-visible, .section-icon-trigger:hover)) .section-title svg {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-title svg {
      transition: none;
    }
  }

  @media (min-width: 40em) {
    .section-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-title {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60em) {
    .section-row {
      grid-template-columns: minmax(0, 3fr) repeat(2, minmax(0, 4fr));
    }

    .section-title {
      grid-column: auto;
    }
  }
</style>
