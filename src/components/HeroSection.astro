---
import MailIcon from '../icons/mail.svg';
import DownloadIcon from '../icons/download.svg';
import LanguageIcon from '../icons/language.svg';
import TextLink from './TextLink.astro';
import { profile } from '../data/profile';
---

<header class="hero">
  <div class="hero-content">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <nav class="hero-top-bar" aria-label="Contact and language">
    <span class="hero-email">
      <TextLink href={`mailto:${profile.email}`} tone="on-dark">
        <MailIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
        {profile.email}
      </TextLink>
    </span>
    {profile.resumeHref && (
      <>
        <span class="hero-link-separator hero-link-separator--after-email" aria-hidden="true">/</span>
        <TextLink href={profile.resumeHref} download={profile.resumeFilename} tone="on-dark">
          <DownloadIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
          cv.pdf
        </TextLink>
      </>
    )}
    <span class="hero-link-separator" aria-hidden="true">/</span>
    <span class="hero-lang" role="group" aria-label="Language">
      <LanguageIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
      <span class="hero-lang-option" lang="en" aria-current="true">EN</span>
      <span class="hero-lang-option hero-lang-option--soon" lang="fr" aria-disabled="true" title="Version française bientôt disponible">
        FR<span class="visually-hidden"> (French version coming soon)</span>
      </span>
    </span>
  </nav>
</header>

<style>
  .hero {
    --button-accent: var(--color-peach);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 72px 16px;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 100%;
    text-align: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-on-dark);
    overflow-wrap: anywhere;

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-role {
    padding: 8px 16px;
    border: 1px solid rgb(253 238 223 / 0.35);
    border-radius: 999px;
    font-size: 0.9375rem;
    background-color: rgb(253 238 223 / 0.08);
    color: var(--color-on-dark);

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-top-bar {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: var(--z-content);
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
  }

  .hero-link-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    shape-rendering: crispEdges;
  }

  .hero-link-separator {
    color: rgb(253 238 223 / 0.4);
  }

  .hero-lang {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-on-dark);
  }

  .hero-lang-option[aria-current="true"] {
    padding-block: 4px;
    background: linear-gradient(var(--color-peach), var(--color-peach)) no-repeat 0 100% / 100% 2px;
  }

  .hero-lang-option--soon {
    color: rgb(253 238 223 / 0.55);
    cursor: default;
  }

  @media (max-width: 40em) {
    .hero-top-bar {
      left: 16px;
      flex-wrap: wrap;
      justify-content: flex-end;
      row-gap: 4px;
    }

    .hero-email {
      display: flex;
      justify-content: flex-end;
      flex-basis: 100%;
    }

    .hero-link-separator--after-email {
      display: none;
    }
  }

  @media print {
    .hero {
      display: none;
    }
  }
</style>
