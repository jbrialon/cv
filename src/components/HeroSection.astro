---
import ButtonLink from './ButtonLink.astro';
import { profile } from '../data/profile';
---

<header class="hero">
  <div class="hero-content">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <div class="hero-top-bar">
    <ButtonLink href={`mailto:${profile.email}`} variant="light">{profile.email}</ButtonLink>
  </div>
</header>

<style>
  .hero {
    --button-accent: var(--color-peach);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 72px 16px;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: var(--z-background);
      background: linear-gradient(to bottom, var(--sky-8), var(--sky-7) 55%, var(--sky-6));
    }
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 100%;
    text-align: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-on-dark);
    overflow-wrap: anywhere;

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-role {
    padding: 8px 16px;
    border: 1px solid rgb(253 238 223 / 0.35);
    border-radius: 999px;
    font-size: 0.9375rem;
    background-color: rgb(253 238 223 / 0.08);
    color: var(--color-on-dark);

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-top-bar {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: var(--z-content);
  }

  @media print {
    .hero {
      display: none;
    }
  }
</style>
