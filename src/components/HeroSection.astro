---
import ButtonLink from './ButtonLink.astro';
import { profile } from '../data/profile';
---

<header class="hero">
  <div class="hero-content">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <div class="hero-top-bar">
    <ButtonLink href={`mailto:${profile.email}`}>{profile.email}</ButtonLink>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 4.5rem 1rem;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: var(--z-background);
      background: var(--color-feldgrau);
    }

    & :global(.button-link:focus-visible) {
      outline-color: var(--color-jasmine);
    }
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 100%;
    text-align: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-jasmine);
    overflow-wrap: anywhere;
  }

  .hero-role {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-forest);
    color: var(--color-jasmine);
    font-size: 0.9375rem;
  }

  .hero-top-bar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: var(--z-content);
  }
</style>
