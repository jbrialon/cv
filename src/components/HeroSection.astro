---
import MailIcon from '../icons/mail.svg';
import DownloadIcon from '../icons/download.svg';
import ButtonLink from './ButtonLink.astro';
import { profile } from '../data/profile';
---

<header class="hero">
  <div class="hero-content">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <nav class="hero-top-bar" aria-label="Contact">
    <a class="hero-link" href={`mailto:${profile.email}`}>
      <MailIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
      <span class="hero-email-label">{profile.email}</span>
    </a>
    {profile.resumeHref && (
      <>
        <span class="hero-link-separator" aria-hidden="true">/</span>
        <a class="hero-link" href={profile.resumeHref} download="Jeremy-Brialon-CV.pdf">
          <DownloadIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
          cv.pdf
        </a>
      </>
    )}
  </nav>
</header>

<style>
  .hero {
    --button-accent: var(--color-peach);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 72px 16px;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: var(--z-background);
      background: linear-gradient(to bottom, var(--sky-8), var(--sky-7) 55%, var(--sky-6));
    }
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 100%;
    text-align: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-on-dark);
    overflow-wrap: anywhere;

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-role {
    padding: 8px 16px;
    border: 1px solid rgb(253 238 223 / 0.35);
    border-radius: 999px;
    font-size: 0.9375rem;
    background-color: rgb(253 238 223 / 0.08);
    color: var(--color-on-dark);

    &::selection {
      background: var(--color-on-dark);
      color: var(--color-ink);
    }
  }

  .hero-top-bar {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: var(--z-content);
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
  }

  /* quiet mono links, a peach underline grows on hover */
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-block: 4px;
    color: var(--color-on-dark);
    text-decoration: none;
    background-image: linear-gradient(var(--color-peach), var(--color-peach));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 20px 2px;
    transition:
      background-size 0.45s var(--ease-out-quart),
      color 0.25s linear;

    &:hover {
      color: var(--color-peach);
      background-size: 100% 2px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-on-dark);
      outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .hero-link-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    shape-rendering: crispEdges;
  }

  .hero-link-separator {
    color: rgb(253 238 223 / 0.4);
  }

  @media print {
    .hero {
      display: none;
    }
  }
</style>
