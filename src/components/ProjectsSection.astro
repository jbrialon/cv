---
import { getCollection } from "astro:content";
import WindowFrame from "./WindowFrame.astro";

const projectEntries = (await getCollection("projects")).sort(
  (firstEntry, secondEntry) => firstEntry.data.order - secondEntry.data.order,
);
const formatNumber = (value: number) => String(value).padStart(2, "0");
---

<WindowFrame id="projects" label="Selected client projects" filename="selected-projects/" tone="sky">
  <Fragment slot="meta">{formatNumber(projectEntries.length)} items</Fragment>

  <ol class="projects-list" role="list">
    {projectEntries.map(({ data: project }) => (
      <li class="project-item">
        <span class="project-number">{formatNumber(project.order)}</span>
        <span><b>{project.name}</b>{project.detail && `, ${project.detail}`}</span>
        <span class="project-role">{project.role}{project.award && ` (${project.award})`}</span>
      </li>
    ))}
  </ol>
</WindowFrame>

<style>
  .projects-list {
    list-style: none;
    margin: 24px;
    border-bottom: 1px solid var(--color-ink);
  }

  .project-item {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--color-ink);
  }

  .project-number,
  .project-role {
    color: var(--color-ink-soft);
  }

  .project-role {
    grid-column: 2;
  }

  @media (min-width: 40em) {
    .projects-list {
      margin: 40px;
    }
  }

  @media (min-width: 60em) {
    .project-item {
      grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: baseline;
    }

    .project-role {
      grid-column: auto;
    }
  }
</style>
