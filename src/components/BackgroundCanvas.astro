<div class="background-canvas" data-background-canvas aria-hidden="true">
  <canvas class="background-canvas__canvas"></canvas>
</div>

<script>
  const targetElement = document.querySelector<HTMLElement>('[data-background-canvas]');
  const canvas = targetElement?.querySelector('canvas');

  // wait for the page to be fully loaded so three.js never slows down the CV itself
  async function startExperience() {
    const { default: Experience } = await import('../experience/experience.js');
    new Experience({ targetElement, canvas });
  }

  if (targetElement && canvas) {
    if (document.readyState === 'complete') {
      startExperience();
    } else {
      window.addEventListener('load', startExperience, { once: true });
    }
  }
</script>

<style>
  .background-canvas {
    position: fixed;
    inset: 0;
    z-index: var(--z-webgl);
    width: 100%;
    height: 100lvh;

    pointer-events: none;
  }

  .background-canvas__canvas {
    display: block;
    outline: none;
  }

  :global(.tp-dfwv) {
    position: fixed;
    z-index: var(--z-debug);
  }
</style>
