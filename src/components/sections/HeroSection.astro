---
import MailIcon from '../../icons/mail.svg';
import DownloadIcon from '../../icons/download.svg';
import LanguageIcon from '../../icons/language.svg';
import TextLink from '../ui/TextLink.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getProfile } from '../../data/profile';
import { defaultLocale, languages, useTranslations } from '../../i18n/ui';

const currentLocale = Astro.currentLocale ?? defaultLocale;
const translate = useTranslations(currentLocale);
const profile = getProfile(currentLocale);
---

<header class="hero">
  <div class="hero-content">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <nav class="hero-top-bar" aria-label={translate("nav.contactAndLanguage")}>
    <span class="hero-email">
      <TextLink href={`mailto:${profile.email}`} tone="on-dark">
        <MailIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
        {profile.email}
      </TextLink>
    </span>
    {profile.resumeHref && (
      <>
        <span class="hero-link-separator hero-link-separator--after-email" aria-hidden="true">/</span>
        <TextLink href={profile.resumeHref} download={profile.resumeFilename} tone="on-dark">
          <DownloadIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
          cv.pdf
        </TextLink>
      </>
    )}
    <span class="hero-link-separator" aria-hidden="true">/</span>
    <span class="hero-lang" role="group" aria-label={translate("nav.language")}>
      <LanguageIcon class="hero-link-icon" width="12" height="12" aria-hidden="true" />
      {languages.map((language) =>
        language.locale === currentLocale ? (
          <span class="hero-lang-option" lang={language.locale} aria-current="true">
            {language.label}<span class="visually-hidden"> ({language.name})</span>
          </span>
        ) : (
          <a class="hero-lang-option hero-lang-link" href={getRelativeLocaleUrl(language.locale)} lang={language.locale} hreflang={language.locale}>
            {language.label}<span class="visually-hidden"> ({language.name})</span>
          </a>
        )
      )}
    </span>
  </nav>
</header>

<style>
  .hero {
    --button-accent: var(--color-peach);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 72px 16px;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: var(--z-background);
      background: linear-gradient(to bottom, var(--sky-8), var(--sky-7) 55%, var(--sky-6));
      transition: opacity 0.6s ease 0.3s;
    }

    :global(html[data-background-ready]) &::before {
      opacity: 0;
    }
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 100%;
    text-align: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--color-on-dark);
    overflow-wrap: anywhere;
  }

  .hero-role {
    padding: 8px 16px;
    border: 1px solid rgb(253 238 223 / 0.35);
    border-radius: 999px;
    font-size: 0.9375rem;
    background-color: rgb(253 238 223 / 0.08);
    color: var(--color-on-dark);
  }

  .hero-top-bar {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: var(--z-content);
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
  }

  .hero-link-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    shape-rendering: crispEdges;
  }

  .hero-link-separator {
    color: rgb(253 238 223 / 0.4);
  }

  .hero-lang {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-on-dark);
  }

  .hero-lang-option {
    padding-block: 4px;
    background: linear-gradient(var(--color-peach), var(--color-peach)) no-repeat 0 100% / 100% 2px;
  }

  .hero-lang-link {
    color: rgb(253 238 223 / 0.55);
    text-decoration: none;
    background-size: 0 2px;
    transition:
      background-size 0.45s var(--ease-out-quart),
      color 0.25s linear;

    &:hover {
      color: var(--color-on-dark);
      background-size: 100% 2px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-on-dark);
      outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  @media (max-width: 40em) {
    .hero-top-bar {
      left: 16px;
      flex-wrap: wrap;
      justify-content: flex-end;
      row-gap: 4px;
    }

    .hero-email {
      display: flex;
      justify-content: flex-end;
      flex-basis: 100%;
    }

    .hero-link-separator--after-email {
      display: none;
    }
  }

  @media print {
    .hero {
      display: none;
    }
  }
</style>
