---
import { profile } from "../data/profile";

const toReadableUrl = (href: string) => href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");

const contactItems = [
  { label: toReadableUrl(profile.website), href: profile.website },
  { label: profile.email, href: `mailto:${profile.email}` },
].concat(
  profile.contactLinks.map((contactLink) => ({
    label: contactLink.printLabel ?? (contactLink.external ? toReadableUrl(contactLink.href) : contactLink.label),
    href: contactLink.href,
  })),
);
---

<header class="print-header">
  <h1 class="print-name">{profile.name}</h1>
  <p class="print-role">{profile.role}</p>
  <p class="print-location">{profile.location}</p>
  <p class="print-languages">
    {profile.languages.map((language, index) => (
      <span>
        {index > 0 && <span class="print-separator" aria-hidden="true">·</span>}
        <b>{language.name}</b> ({language.level})
      </span>
    ))}
  </p>
  <ul class="print-contact" role="list">
    {contactItems.map((contactItem, index) => (
      <li>
        <a href={contactItem.href}>{contactItem.label}</a>
        {index < contactItems.length - 1 && <span class="print-separator" aria-hidden="true">·</span>}
      </li>
    ))}
  </ul>
</header>

<style>
  .print-header {
    display: none;
  }

  @media print {
    .print-header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--print-accent);
    }

    .print-name {
      margin-bottom: 4px;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 2.75rem;
      line-height: 1;
      color: var(--sky-7);
    }

    .print-role {
      font-size: 1.125rem;
    }

    .print-location,
    .print-languages,
    .print-contact {
      font-size: 0.875rem;
    }

    .print-languages b {
      font-weight: 600;
    }

    .print-contact {
      list-style: none;
      display: flex;
      flex-wrap: wrap;

      a {
        text-decoration: none;
      }
    }

    .print-separator {
      padding-inline: 8px;
      color: var(--print-accent);
    }
  }
</style>
