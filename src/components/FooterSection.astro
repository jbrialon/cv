---
import TextLink from "./TextLink.astro";
import ArrowRightIcon from "../icons/arrow-right.svg";
import { profile } from "../data/profile";

const externalLinks = profile.contactLinks.filter((contactLink) => contactLink.external);
const buildYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-meta">
    <span>© {buildYear} {profile.name}</span>

    <nav aria-label="Contact">
      <ul class="footer-links" role="list">
        <li><TextLink href={`mailto:${profile.email}`}>email</TextLink></li>
        {externalLinks.map((contactLink) => (
          <li>
            <TextLink href={contactLink.href} external>{contactLink.label.toLowerCase()}</TextLink>
          </li>
        ))}
        {profile.resumeHref && (
          <li><TextLink href={profile.resumeHref} download="Jeremy-Brialon-CV-EN.pdf">cv.pdf</TextLink></li>
        )}
      </ul>
    </nav>

    <a class="back-to-top" href="#">
      Back to top
      <ArrowRightIcon class="back-to-top-icon" width="12" height="12" aria-hidden="true" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    max-width: 1040px;
    margin: 0 auto;
    padding: 32px;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    color: var(--color-ink-soft);
    text-decoration: none;

    &:hover {
      color: var(--color-ink);
    }

    &:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }
  }

  .back-to-top-icon {
    flex-shrink: 0;
    transform: rotate(-90deg);
  }

  @media (max-width: 40em) {
    .site-footer {
      padding: 96px 16px 24px;
    }

    .footer-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media print {
    .site-footer {
      display: none;
    }
  }
</style>