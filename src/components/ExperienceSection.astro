---
import { getCollection } from "astro:content";
import WindowFrame from "./WindowFrame.astro";
import ArrowRightIcon from "../icons/arrow-right.svg";

const experienceEntries = (await getCollection("experience")).sort(
  (firstEntry, secondEntry) => secondEntry.data.startDate.getTime() - firstEntry.data.startDate.getTime(),
);

const monthYearFormat = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const toIsoMonth = (date: Date) => date.toISOString().slice(0, 7);

const firstYear = experienceEntries.reduce(
  (earliestYear, { data }) => Math.min(earliestYear, data.startDate.getUTCFullYear()),
  Infinity,
);
const lastYear = experienceEntries.reduce(
  (latestYear, { data }) => Math.max(latestYear, data.endDate.getUTCFullYear()),
  -Infinity,
);
---

<WindowFrame id="experience" label="Experience" filename="experience.json">
  <span slot="meta" class="year-range">
    {firstYear}
    <ArrowRightIcon class="year-range-arrow" width="12" height="12" aria-hidden="true" />
    <span class="visually-hidden">to</span>
    {lastYear}
  </span>

  <div class="experience-body">
    {experienceEntries.map(({ data: job }) => (
      <article class="experience-entry">
        <div class="experience-meta">
          <h3 class="heading-3">{job.role}</h3>
          <p class="paragraph">{job.company}<br />{job.location}</p>
          <p class="paragraph experience-dates">
            <time datetime={toIsoMonth(job.startDate)}>{monthYearFormat.format(job.startDate)}</time>
            <ArrowRightIcon class="year-range-arrow" width="12" height="12" aria-hidden="true" />
            <span class="visually-hidden">to</span>
            <time datetime={toIsoMonth(job.endDate)}>{monthYearFormat.format(job.endDate)}</time>
          </p>
        </div>

        <ul class="experience-highlights" role="list">
          {job.highlights.map((highlight) => <li class="paragraph">{highlight}</li>)}
        </ul>
      </article>
    ))}
  </div>
</WindowFrame>

<style>
  .experience-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 24px;
  }

  .experience-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;

    & + & {
      padding-top: 32px;
      border-top: 1px solid var(--color-hairline);
    }

    &:last-child {
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-hairline);
    }
  }

  .experience-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .experience-dates {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink-soft);
  }

  .year-range {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .year-range-arrow {
    flex-shrink: 0;
  }

  .experience-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;

    li {
      display: flex;
      gap: 12px;

      &::before {
        content: ">";
        flex-shrink: 0;
        color: var(--color-accent);
      }
    }
  }

  @media (min-width: 40em) {
    .experience-body {
      padding: 40px;
    }

    .experience-entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 40px;
    }
  }
</style>
