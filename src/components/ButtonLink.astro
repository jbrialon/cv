---
import ExternalLinkIcon from '../icons/external-link.svg';

interface Props {
  href: string;
  external?: boolean;
  variant?: "dark" | "light";
}

const { href, external = false, variant = "dark" } = Astro.props;
---

<a
  class:list={["button-link", `button-link--${variant}`, `theme-${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {external && (
    <>
      <ExternalLinkIcon class="button-link-icon" width="12" height="12" aria-hidden="true" />
      <span class="visually-hidden"> (opens in a new tab)</span>
    </>
  )}
</a>

<style>
  .button-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
    box-shadow: 0 0 0 0 var(--color-shadow);
    transition:
      transform 0.25s var(--ease-out-quart),
      box-shadow 0.25s var(--ease-out-quart);

    &:hover {
      transform: translateY(-4px) scale(1.04);
      box-shadow: 4px 6px 0 -1px var(--color-shadow);
    }

    &:active {
      transform: scale(0.97);
      box-shadow: 1px 2px 0 -1px var(--color-shadow);
      transition-duration: 0.08s;
    }

    &:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }

    @media (hover: none) {
      &:hover {
        transform: none;
        box-shadow: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;

      &:hover,
      &:active {
        transform: none;
      }
    }
  }

  .button-link--dark:hover {
    color: var(--color-on-dark);
  }

  .button-link--light:hover {
    color: var(--color-ink);
  }

  .button-link-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    shape-rendering: crispEdges;
  }
</style>
