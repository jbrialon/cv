---
import ExternalLinkIcon from '../icons/external-link.svg';

interface Props {
  href: string;
  external?: boolean;
  variant?: "dark" | "light";
}

const { href, external = false, variant = "dark" } = Astro.props;
---

<a
  class:list={["button-link", `button-link--${variant}`, { "theme-dark": variant === "dark", "theme-light": variant === "light" }]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {external && (
    <>
      <ExternalLinkIcon class="button-link-icon" width="12" height="12" aria-hidden="true" />
      <span class="visually-hidden"> (opens in a new tab)</span>
    </>
  )}
</a>

<style>
  .button-link {
    --button-shadow-color: var(--sky-7);
    --button-shadow-offset: 3px;

    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 1.5px solid var(--sky-7);
    border-radius: 6px;
    font-size: 0.875rem;
    text-decoration: none;
    box-shadow: var(--button-shadow-offset) var(--button-shadow-offset) 0 var(--button-shadow-color);
    transition:
      transform 0.25s var(--ease-out-quart),
      box-shadow 0.25s var(--ease-out-quart),
      background-color 0.25s linear;

    &:hover {
      --button-shadow-offset: 5px;
      transform: translate(-2px, -2px);
    }

    &:active {
      --button-shadow-offset: 0px;
      transform: translate(2px, 2px);
      transition-duration: 0.08s;
    }

    &:focus-visible {
      outline: 2px solid var(--color-paper);
      outline-offset: 0;
      box-shadow: 0 0 0 4px var(--sky-7);
    }

    @media (hover: none) {
      &:hover {
        --button-shadow-offset: 3px;
        transform: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;

      &:hover,
      &:active {
        transform: none;
      }
    }
  }

  /* night sky stamp with a navy shadow */
  .button-link--dark {
    background-color: var(--blob-sunrise-night-1);
    color: var(--color-on-dark);

    &:hover {
      color: var(--color-on-dark);
    }
  }

  /* paper stamp, shadow follows the live section marker colour */
  .button-link--light {
    --button-shadow-color: var(--button-accent, var(--color-marker));
    background-color: var(--color-paper);
    color: var(--sky-7);

    &:hover {
      color: var(--sky-7);
    }
  }

  .button-link-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    shape-rendering: crispEdges;
  }
</style>
