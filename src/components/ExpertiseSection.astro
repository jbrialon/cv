---
import SectionRow from "./SectionRow.astro";
import { skillGroups } from "../data/expertise";
---

<SectionRow title="Expertise" id="expertise" icon="pyramid">
  {skillGroups.map((skillGroup) => (
    <div class="skill-group">
      <h3 class="heading-3">{skillGroup.title}</h3>
      <ul class="skill-list" role="list">
        {skillGroup.skills.map((skill) => (
          <li class:list={["skill-tag", { "theme-dark": skillGroup.emphasis === "primary" }, "section-icon-trigger"]}>{skill}</li>
        ))}
      </ul>
    </div>
  ))}
</SectionRow>

<style>
  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.4;
    background-color: var(--color-paper);
    color: var(--sky-7);

    &.theme-dark {
      background-color: var(--blob-sunrise-night-1);
      color: var(--color-on-dark);
    }
  }
</style>