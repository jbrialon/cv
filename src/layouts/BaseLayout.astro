---
import { Font } from 'astro:assets';
import '../styles/style.css';
import '../styles/print.css';
import { profile } from '../data/profile';
import { defaultLocale, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
}

const { title } = Astro.props;

const currentLocale = Astro.currentLocale ?? defaultLocale;
const translate = useTranslations(currentLocale);
const description = translate("meta.description");
// social networks need absolute urls
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`/og-image-${currentLocale}.jpg`, Astro.site);
---

<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#222328" />
    <link rel="canonical" href={pageUrl} />
    <!-- opengraph -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="profile" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={currentLocale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <Font cssVariable="--font-mono" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-serif" preload />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
